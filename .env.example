# ===================================================
# Dadi's Recipe Vault - Environment Variables
# ===================================================

# --- BACKEND SETTINGS ---
PORT=8000

# Open-Source AI: Meta Llama 3.1 8B Instruct
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Or Hugging Face Token:
# HF_TOKEN=hf_your_token_here

# SQLite Database Path
DATABASE_PATH=recipes.db

# --- FRONTEND SETTINGS ---
# Set to your deployed Render backend URL for production (e.g., https://dadis-recipe-vault-api.onrender.com)
# In local development, leave blank or set to http://localhost:8000
VITE_API_URL=http://localhost:8000
