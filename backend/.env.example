# Port (set automatically by Render or default 8000 locally)
PORT=8000

# Open-Source / Open-Weight AI Configuration
# Recommended: Groq API key for blazing fast Meta Llama 3.1 8B Instruct (Free tier available at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Alternative: Hugging Face User Access Token (for meta-llama/Meta-Llama-3-8B-Instruct)
HF_TOKEN=hf_your_huggingface_token_here

# Alternative: Any local or remote OpenAI-compatible server (e.g. Ollama http://localhost:11434/v1)
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL_NAME=llama3.1:8b

# Database Path (default: recipes.db)
DATABASE_PATH=recipes.db
